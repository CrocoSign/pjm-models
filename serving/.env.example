# Copy to .env — signsdk auto-loads it.

# Device: cuda (GPU) or cpu. Needs the signsdk[gpu] install for cuda.
SIGNSDK_DEVICE=cuda

# Models kept resident (LRU; evicting frees the GPU). Each SpaMo is ~11.5 GB on GPU,
# so on a 24 GB card keep this at 1.
SIGNSDK_MAX_RESIDENT=1

# Fall back to CPU if fewer than this many MiB are free on the GPU (avoids OOM).
# SIGNSDK_SPAMO_GPU_MIB=22000
# SIGNSDK_UNISIGN_GPU_MIB=5000

# Cap input frames for SpaMo (native max_frame_length=512). Lower if a long clip OOMs.
# SIGNSDK_MAX_FRAMES=512

# VideoMAE batch (lower = less GPU memory). Default 8.
# SIGNSDK_MAE_BATCH=8

# Where models are cached (default ~/.cache/signsdk) / which HF repo to pull from.
# SIGNSDK_HOME=/data/signsdk
# SIGNSDK_HF_REPO=croco-corp/pjm-models
