# Copy to .env — signsdk auto-loads it (real env vars still win).

# Runtime device: "cuda" (GPU) or "cpu". With onnxruntime-gpu installed this flips
# GPU<->CPU with NO reinstall (onnxruntime-gpu ships both providers).
SIGNSDK_DEVICE=cuda

# Where downloaded model artifacts are cached (default: ~/.cache/signsdk)
# SIGNSDK_HOME=/data/signsdk

# HuggingFace artifact repo (default: croco-corp/pjm-models)
# SIGNSDK_HF_REPO=croco-corp/pjm-models

# Max models kept resident when using signsdk.load() (LRU; evicting frees memory).
# Each SpaMo model is ~11.5 GB on GPU, so keep this low on a 24 GB card. Default 2.
# SIGNSDK_MAX_RESIDENT=1

# VideoMAE batch for the SpaMo motion stream. Lower = less GPU memory, slightly slower.
# Default 8 (~1.3 GB); raise on a big GPU. (32 needs ~5 GB and can OOM.)
# SIGNSDK_MAE_BATCH=8

# Cap input frames for SpaMo (native max_frame_length=512). Lower if a long clip
# still OOMs the GPU. Default 512.
# SIGNSDK_MAX_FRAMES=512
